prefix=/home/man-me/Documents/MAN.Dev/1.Repos/Work/SchemaCraft/Updates/SchemaCraft_PostgreSQL_Update/build/platforms/windows/runtime/postgresql
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libecpg_compat
Description: PostgreSQL libecpg_compat library
URL: https://www.postgresql.org/
Version: 18.6
Requires: 
Requires.private: libecpg, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg_compat
Libs.private:  -lecpg -lpgcommon -lpgport -lpq -lm
