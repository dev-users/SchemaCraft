prefix=/home/man-me/Documents/MAN.Dev/1.Repos/Work/SchemaCraft/Updates/SchemaCraft_PostgreSQL_Update/build/platforms/windows/runtime/postgresql
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libecpg
Description: PostgreSQL libecpg library
URL: https://www.postgresql.org/
Version: 18.6
Requires: 
Requires.private: libpq, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg
Libs.private:  -lpgcommon -lpgport -lpq -lm
